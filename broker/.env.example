# Copy to broker/.env and keep that file private.
POSTGRES_PASSWORD=replace-with-a-long-random-password
BROKER_OIDC_AUDIENCE=https://reviews.example.com/second-opinion
# Generate with: openssl rand -base64 32
BROKER_MASTER_KEY=replace-with-exactly-32-base64-encoded-random-bytes
# For rotation, replace the single key above with a JSON keyring and active version:
# BROKER_MASTER_KEYS={"1":"OLD_BASE64_KEY","2":"NEW_BASE64_KEY"}
# BROKER_ACTIVE_KEY_VERSION=2
# Optional: required only when a hosted GitHub App service calls /v1/internal/reviews.
# Generate independently with: openssl rand -base64 36
# BROKER_SERVICE_TOKEN=replace-with-a-separate-long-random-token
# Optional: credential UUID returned by `admin enroll`; enables hosted App auto-enrollment.
# BROKER_DEFAULT_CREDENTIAL_ID=00000000-0000-4000-8000-000000000000

# Optional deployment tuning.
CODEX_VERSION=0.147.0
BROKER_ALLOWED_MODELS=gpt-5.6-sol
BROKER_DEFAULT_MODEL=gpt-5.6-sol
BROKER_MAX_CONCURRENCY=2
BROKER_MAX_QUEUE=20
BROKER_PER_REPO_HOURLY_LIMIT=20
BROKER_SERVICE_HOURLY_LIMIT=100
BROKER_PORT=3000
