PUBLIC_URL=https://second-opinion.example
# Leave HOST unset for a host process; the container image sets it to 0.0.0.0.
SESSION_SECRET=replace-with-at-least-32-random-bytes
GITHUB_WEBHOOK_SECRET=replace-with-a-high-entropy-webhook-secret
GITHUB_APP_ID=123456
GITHUB_APP_SLUG=second-opinion-hosted
GITHUB_CLIENT_ID=Iv1.replace-me
GITHUB_CLIENT_SECRET=replace-me
GITHUB_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----\nreplace-me\n-----END RSA PRIVATE KEY-----
GITHUB_BOT_LOGIN=second-opinion-hosted[bot]

# Configure one or more service-owned review backends.
# OPENAI_API_KEY=replace-me
# ANTHROPIC_API_KEY=replace-me
# CODEX_BROKER_URL=https://codex-broker.example
# CODEX_BROKER_TOKEN=replace-with-the-same-separate-32-byte-token-as-the-broker

HOSTED_MONTHLY_REVIEW_LIMIT=25
HOSTED_RATE_LIMIT_PER_MINUTE=10
HOSTED_WORKERS=2
HOSTED_MAX_QUEUE=100
HOSTED_REVIEW_TIMEOUT_SECONDS=1200
